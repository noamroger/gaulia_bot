# ─── Discord ─────────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# ID(s) du/des propriétaire(s) du bot, séparés par des virgules (accès aux commandes owner-only)
OWNER_IDS=
# Serveur Discord utilisé pour déployer les commandes en dev (npm run deploy:guild)
DEV_GUILD_ID=

# ─── Sharding ────────────────────────────────────────────────────────────
# Nombre fixe de shards (ou "auto" pour laisser discord.js calculer le nombre recommandé)
TOTAL_SHARDS=4

# ─── Base de données (PostgreSQL) ──────────────────────────────────────────
POSTGRES_USER=gaulia
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gaulia
# En local hors Docker : postgresql://gaulia:changeme@localhost:5432/gaulia
# Dans docker-compose : postgresql://gaulia:changeme@postgres:5432/gaulia
DATABASE_URL=postgresql://gaulia:changeme@localhost:5432/gaulia

# ─── Lavalink (node local, voir docker/lavalink/) ─────────────────────────
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=changeme-lavalink-password
LAVALINK_SECURE=false

# ─── YouTube (plugin youtube-source de Lavalink) ──────────────────────────
# Mot de passe partagé entre Lavalink et le service yt-cipher (déchiffrement des signatures).
# Génère une valeur aléatoire (ex: openssl rand -hex 32). Obligatoire.
YT_CIPHER_TOKEN=

# ─── LavaSrc (optionnel, résolution des liens/recherches Spotify côté Lavalink) ─
# Créer une app sur https://developer.spotify.com/dashboard pour obtenir ces identifiants.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Premium (Monetization API) ────────────────────────────────────────────
# SKU id premium créé dans le portail développeur Discord (onglet Monetization)
PREMIUM_SKU_ID=

# ─── API du dashboard (OAuth2 Discord) ─────────────────────────────────────
# Pas de reverse proxy inclus dans ce compose (branche le tien en amont) :
#   <ton-domaine>       -> ce serveur, port 4500 (service "dashboard")
#   api.<ton-domaine>   -> ce serveur, port 4501 (service "api")
# DISCORD_CLIENT_SECRET (ci-dessus) est aussi requis ici. L'URI ci-dessous doit être enregistrée
# comme redirect URI valide sur le portail développeur Discord (onglet OAuth2).
DISCORD_REDIRECT_URI=https://api.example.com/auth/callback
DASHBOARD_URL=https://example.com
# Secret de signature des sessions JWT — génère une valeur aléatoire forte (ex: openssl rand -hex 32)
JWT_SECRET=changeme-generate-a-random-secret
API_PORT=4000
# Vu par le navigateur (dashboard Next.js) — doit pointer vers l'URL publique de l'API (celle
# derrière ton reverse proxy), pas le nom de service Docker interne ni le port 4501 directement.
NEXT_PUBLIC_API_URL=https://api.example.com
# Adresse affichée sur /privacy pour les demandes d'accès ou de suppression de données (build).
NEXT_PUBLIC_CONTACT_EMAIL=

# ─── Divers ─────────────────────────────────────────────────────────────
# "production" tant que ce .env sert à un déploiement réel (cookies sécurisés, logs JSON) ;
# passe à "development" uniquement pour du dev local sans HTTPS.
NODE_ENV=production
LOG_LEVEL=info
