generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Configuration générale d'un serveur Discord.
model Guild {
  id                  String   @id
  /// Dénormalisé depuis discord.js (guildCreate/guildUpdate/ready) pour que le panel admin
  /// puisse afficher un nom pour TOUS les serveurs, même ceux où l'admin connecté n'est pas membre.
  name                String?
  /// Hash d'icône Discord et nombre de membres, synchronisés par le bot pour le panel admin.
  icon                String?
  memberCount         Int      @default(0)
  language            String   @default("fr")
  premium             Boolean  @default(false)
  premiumExpiresAt    DateTime?
  /// Premium offert en échange de crédits (voir CreditAccount) : indépendant de `premium`, qui
  /// reflète les entitlements Discord. Le serveur est premium si l'un OU l'autre est actif.
  premiumGrantedUntil DateTime?
  /// Faux dès que le bot quitte le serveur (guildDelete) ; permet à l'API/dashboard de ne lister
  /// que les serveurs où le bot est réellement présent, sans perdre l'historique associé.
  botPresent          Boolean  @default(true)

  modLogChannelId     String?
  automodLogChannelId String?
  djRoleId            String?
  musicChannelId      String?
  /// Salons où les commandes du module fun sont utilisables ; liste vide = tous les salons.
  funChannelIds       String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moderationCases ModerationCase[]
  warns           Warn[]
  automodConfig      AutomodConfig?
  musicSettings      MusicSettings?
  moderationSettings ModerationSettings?
  blindtestPlaylists BlindtestPlaylist[]
  adventureSettings  AdventureSettings?

  @@map("guilds")
}

enum ModerationCaseType {
  BAN
  UNBAN
  KICK
  TIMEOUT
  UNTIMEOUT
  WARN
  UNWARN
  PURGE
}

/// Historique de modération, numéroté par serveur (caseNumber).
model ModerationCase {
  id           Int                @id @default(autoincrement())
  guildId      String
  guild        Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  caseNumber   Int
  type         ModerationCaseType
  targetId     String
  targetTag    String
  moderatorId  String
  moderatorTag String
  reason       String?
  durationSecs Int?
  createdAt    DateTime           @default(now())

  @@unique([guildId, caseNumber])
  @@index([guildId, targetId])
  @@map("moderation_cases")
}

/// Avertissement individuel (peut être révoqué sans supprimer l'historique).
model Warn {
  id          Int      @id @default(autoincrement())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId      String
  moderatorId String
  reason      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([guildId, userId])
  @@map("warns")
}

/// Réglages de la couche automod custom (en complément de l'AutoMod natif Discord).
model AutomodConfig {
  guildId String @id
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  /// Règles et sanctions, validées par `automodRulesSchema` (src/schemas/automod.ts) : ajouter une
  /// option ne demande pas de migration.
  rules             Json     @default("{}")
  ignoredChannelIds String[] @default([])
  ignoredRoleIds    String[] @default([])
  /// Les membres ayant la permission « Gérer les messages » ne sont pas contrôlés.
  exemptStaff       Boolean  @default(true)

  updatedAt DateTime @updatedAt

  @@map("automod_configs")
}

/// Réglages de modération par serveur.
model ModerationSettings {
  guildId        String   @id
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  dmOnSanction   Boolean  @default(true)
  /// Paliers de sanctions automatiques selon le nombre d'avertissements actifs, validés par
  /// `warnEscalationSchema` (src/schemas/moderation.ts).
  warnEscalation Json     @default("[]")
  updatedAt      DateTime @updatedAt

  @@map("moderation_settings")
}

enum LoopMode {
  NONE
  TRACK
  QUEUE
}

/// Réglages musique persistants par serveur.
model MusicSettings {
  guildId     String   @id
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  volume      Int      @default(100)
  stay247     Boolean  @default(false)
  defaultLoop LoopMode @default(NONE)
  /// Salons où `/blindtest` peut être lancé ; liste vide = tous les salons.
  blindtestChannelIds         String[] @default([])
  /// Identifiants des catégories prédéfinies de blindtest désactivées sur ce serveur.
  blindtestDisabledCategories String[] @default([])
  updatedAt   DateTime @updatedAt

  @@map("music_settings")
}

/// Liste de musiques créée par un serveur pour ses blindtests. `tracks` est validé par
/// `blindtestTracksSchema` (src/schemas/blindtest.ts) ; `trackCount` évite de lire le JSON pour lister.
model BlindtestPlaylist {
  id         String   @id @default(cuid())
  guildId    String
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name       String
  tracks     Json     @default("[]")
  trackCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([guildId, name])
  @@map("blindtest_playlists")
}

/// Cache persistant des entitlements Discord (source de vérité de secours après redémarrage).
model PremiumEntitlement {
  id        String    @id
  skuId     String
  guildId   String?
  userId    String?
  deleted   Boolean   @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  updatedAt DateTime  @updatedAt

  @@index([guildId])
  @@map("premium_entitlements")
}

/// Heartbeat écrit périodiquement par chaque process de shard (voir apps/bot/src/core/heartbeat) ;
/// l'API agrège ces lignes pour les statistiques globales affichées sur le dashboard.
model ShardStatus {
  shardId     Int      @id
  guildCount  Int
  memberCount Int      @default(0)
  ping        Int
  memoryMb    Int      @default(0)
  playerCount Int      @default(0)
  startedAt   DateTime
  updatedAt   DateTime @updatedAt

  @@map("shard_status")
}

/// Historique des métriques de chaque shard par tranche de 10 minutes (UTC), pour les graphiques du
/// panel admin. Chaque heartbeat met à jour la tranche courante ; l'API additionne les shards.
model ShardMetricSample {
  shardId     Int
  bucket      DateTime
  guildCount  Int
  memberCount Int
  /// Somme des pings relevés dans la tranche et nombre de relevés, pour en tirer la moyenne.
  pingTotal   Int      @default(0)
  pingSamples Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([shardId, bucket])
  @@index([bucket])
  @@map("shard_metric_samples")
}

/// Compteur agrégé par jour (UTC) et par commande, alimente l'onglet statistiques du panel admin.
model CommandUsageDaily {
  date        DateTime @db.Date
  commandName String
  /// Dossier `modules/<module>` de la commande côté bot, pour filtrer les statistiques par catégorie.
  category    String   @default("other")
  count       Int      @default(0)

  @@id([date, commandName])
  @@index([date])
  @@map("command_usage_daily")
}

/// Compte de crédits d'un utilisateur Discord. Les crédits sont gagnés en votant pour Gaulia sur
/// top.gg (webhook de vote, voir apps/api/src/routes/topgg.routes.ts) et dépensés contre du
/// premium offert sur un serveur (Guild.premiumGrantedUntil). `username`/`avatar` sont
/// dénormalisés depuis le payload du vote pour que le panel admin affiche autre chose qu'un ID.
model CreditAccount {
  userId      String   @id
  username    String?
  avatar      String?
  balance     Int      @default(0)
  /// Total cumulé des crédits gagnés (votes + ajouts admin), jamais décrémenté : sert de repère
  /// historique dans le panel admin.
  totalEarned Int      @default(0)
  voteCount   Int      @default(0)
  lastVoteAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions CreditTransaction[]

  @@index([balance])
  @@map("credit_accounts")
}

enum CreditTransactionType {
  /// Vote sur top.gg
  VOTE
  /// Échange contre du premium offert
  PREMIUM_REDEEM
  /// Ajout ou retrait manuel depuis le panel admin
  ADMIN_ADJUST
}

/// Journal des mouvements de crédits : chaque ligne explique une variation du solde, ce qui rend
/// les ajustements admin traçables et permet d'afficher un historique à l'utilisateur.
model CreditTransaction {
  id           Int                   @id @default(autoincrement())
  userId       String
  account      CreditAccount         @relation(fields: [userId], references: [userId], onDelete: Cascade)
  type         CreditTransactionType
  /// Positif pour un gain, négatif pour une dépense.
  amount       Int
  balanceAfter Int
  /// Serveur concerné pour un échange premium, null sinon.
  guildId      String?
  /// Auteur d'un ajustement admin (OWNER_IDS), null sinon.
  actorId      String?
  reason       String?
  createdAt    DateTime              @default(now())

  @@index([userId, createdAt])
  @@map("credit_transactions")
}

/// Votes top.gg déjà traités, identifiés par l'id du vote fourni dans le webhook. Top.gg réessaie
/// une livraison tant qu'elle n'a pas abouti : cette table garantit qu'un même vote ne crédite
/// l'utilisateur qu'une seule fois.
model TopggVote {
  id        String   @id
  userId    String
  weight    Int      @default(1)
  votedAt   DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("topgg_votes")
}

// ─── Module aventure ────────────────────────────────────────────────────────
// Le personnage est global (un seul par utilisateur Discord, jouable en DM comme sur n'importe
// quel serveur autorisé) : seul l'accès aux salons se règle par serveur, via AdventureSettings.

/// Comment interpréter `channelIds` : liste blanche (seuls ces salons) ou liste noire (tous sauf).
enum AdventureChannelMode {
  ALLOWLIST
  BLOCKLIST
}

/// Accès au module aventure sur un serveur. Par défaut : liste blanche vide, donc l'aventure est
/// injouable dans les salons du serveur tant qu'un salon n'a pas été autorisé (les DM, eux, sont
/// toujours ouverts).
model AdventureSettings {
  guildId     String               @id
  guild       Guild                @relation(fields: [guildId], references: [id], onDelete: Cascade)
  enabled     Boolean              @default(true)
  channelMode AdventureChannelMode @default(ALLOWLIST)
  channelIds  String[]             @default([])
  updatedAt   DateTime             @updatedAt

  @@map("adventure_settings")
}

enum AdventureClass {
  GUERRIER
  MAGE
  RODEUR
}

/// Personnage d'un joueur. `hp` et `energy` sont des valeurs figées à `regenAt` : la régénération
/// réelle est calculée à la lecture (voir services/character/vitalsService.ts côté bot), ce qui
/// évite toute tâche de fond pour des milliers de joueurs.
model AdventureCharacter {
  userId         String         @id
  /// Dénormalisé à chaque partie pour que le panel admin affiche autre chose qu'un identifiant.
  username       String?
  characterClass AdventureClass

  level      Int @default(1)
  /// Expérience accumulée dans le niveau courant (remise à zéro à chaque passage de niveau).
  xp         Int @default(0)
  /// Expérience totale gagnée depuis la création, jamais décrémentée : sert aux classements.
  totalXp    Int @default(0)
  statPoints Int @default(0)
  might      Int @default(0)
  agility    Int @default(0)
  spirit     Int @default(0)

  hp       Int
  energy   Int
  /// Dernier instant où PV et énergie ont été recalculés.
  regenAt  DateTime @default(now())
  gold     Int      @default(0)
  /// Fragments d'écho : monnaie de scénario, gagnée par les quêtes et les donjons, dépensée pour
  /// sceller un chapitre. C'est la ressource qui donne au scénario sa durée de vie.
  echoes   Int      @default(0)

  zoneId          String @default("clairiere")
  actIndex        Int    @default(0)
  chapterIndex    Int    @default(0)
  /// Compteurs des objectifs du chapitre courant, validés par `chapterProgressSchema`.
  chapterProgress Json   @default("{}")
  storyEndedAt    DateTime?

  explorations  Int @default(0)
  victories     Int @default(0)
  defeats       Int @default(0)
  dungeonClears Int @default(0)
  streak        Int @default(0)
  bestStreak    Int @default(0)

  lastPlayedAt  DateTime?
  /// Jour (UTC) du dernier passage compté dans la série quotidienne.
  lastStreakDay DateTime?
  lastDungeonAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        AdventureItem[]
  quests       AdventureQuest[]
  achievements AdventureAchievement[]
  logs         AdventureLog[]

  @@index([level, totalXp])
  @@map("adventure_characters")
}

/// Ligne d'inventaire. `itemId` référence le catalogue de code (modules/adventure/data/items.ts) :
/// ajouter un objet ne demande pas de migration.
model AdventureItem {
  id        Int                @id @default(autoincrement())
  userId    String
  character AdventureCharacter @relation(fields: [userId], references: [userId], onDelete: Cascade)
  itemId    String
  quantity  Int                @default(1)
  /// Vrai pour la pièce portée dans son emplacement (une seule par emplacement, garanti par le service).
  equipped  Boolean            @default(false)
  updatedAt DateTime           @updatedAt

  @@unique([userId, itemId])
  @@index([userId])
  @@map("adventure_items")
}

enum AdventureQuestKind {
  DAILY
  WEEKLY
}

/// Quête d'un lot quotidien ou hebdomadaire. `periodStart` identifie le lot (jour UTC ou lundi
/// UTC) : un nouveau lot est tiré à la première commande de la période, les anciens restent comme
/// historique et sont purgés par le job de rétention.
model AdventureQuest {
  id          Int                @id @default(autoincrement())
  userId      String
  character   AdventureCharacter @relation(fields: [userId], references: [userId], onDelete: Cascade)
  kind        AdventureQuestKind
  questId     String
  target      Int
  progress    Int                @default(0)
  claimedAt   DateTime?
  periodStart DateTime

  @@unique([userId, kind, questId, periodStart])
  @@index([userId, kind, periodStart])
  @@map("adventure_quests")
}

/// Haut fait débloqué (catalogue de code, voir data/achievements.ts).
model AdventureAchievement {
  userId        String
  character     AdventureCharacter @relation(fields: [userId], references: [userId], onDelete: Cascade)
  achievementId String
  unlockedAt    DateTime           @default(now())

  @@id([userId, achievementId])
  @@map("adventure_achievements")
}

enum AdventureLogType {
  STORY
  DUNGEON
  LEVEL_UP
  ADMIN
}

/// Journal du personnage : moments marquants (chapitres, donjons, niveaux) et interventions du
/// panel admin, qui restent ainsi traçables pour le joueur comme pour le propriétaire du bot.
model AdventureLog {
  id        Int                @id @default(autoincrement())
  userId    String
  character AdventureCharacter @relation(fields: [userId], references: [userId], onDelete: Cascade)
  type      AdventureLogType
  message   String
  /// Propriétaire à l'origine d'une intervention admin, null pour un évènement de jeu.
  actorId   String?
  createdAt DateTime           @default(now())

  @@index([userId, createdAt])
  @@map("adventure_logs")
}
