generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// General configuration of a Discord guild.
model Guild {
  id                  String   @id
  /// Denormalized from discord.js (guildCreate/guildUpdate/ready) so the admin panel can show a
  /// name for EVERY guild, including those the signed-in admin is not a member of.
  name                String?
  /// Discord icon hash and member count, synced by the bot for the admin panel.
  icon                String?
  memberCount         Int      @default(0)
  /// Forced guild language: "en", "fr", or "auto" to follow the Discord locale.
  language            String   @default("auto")
  premium             Boolean  @default(false)
  premiumExpiresAt    DateTime?
  /// Premium granted against credits (see CreditAccount): independent of `premium`, which reflects
  /// Discord entitlements. The guild is premium when either one is active.
  premiumGrantedUntil DateTime?
  /// Start of the running granted premium window: used to compute the unused share, refunded as
  /// credits if the guild later subscribes to the paid Discord plan.
  premiumGrantedAt    DateTime?
  /// False as soon as the bot leaves the guild (guildDelete), so the API and dashboard list only
  /// the guilds the bot is actually in, without losing the associated history.
  botPresent          Boolean  @default(true)

  modLogChannelId     String?
  automodLogChannelId String?
  djRoleId            String?
  musicChannelId      String?
  /// Channels where the fun module commands are allowed; empty list = every channel.
  funChannelIds       String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moderationCases ModerationCase[]
  warns           Warn[]
  automodConfig      AutomodConfig?
  musicSettings      MusicSettings?
  moderationSettings ModerationSettings?
  blindtestPlaylists BlindtestPlaylist[]
  adventureSettings  AdventureSettings?

  @@map("guilds")
}

/// Per-user preferences, shared across every guild.
model UserPreference {
  userId String @id
  /// "en", "fr", or "auto" to follow the user's Discord locale.
  language String @default("auto")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

enum ModerationCaseType {
  BAN
  UNBAN
  KICK
  TIMEOUT
  UNTIMEOUT
  WARN
  UNWARN
  PURGE
}

/// Moderation history, numbered per guild (caseNumber).
model ModerationCase {
  id           Int                @id @default(autoincrement())
  guildId      String
  guild        Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  caseNumber   Int
  type         ModerationCaseType
  targetId     String
  targetTag    String
  moderatorId  String
  moderatorTag String
  reason       String?
  durationSecs Int?
  createdAt    DateTime           @default(now())

  @@unique([guildId, caseNumber])
  @@index([guildId, targetId])
  @@map("moderation_cases")
}

/// A single warn (can be revoked without deleting the history).
model Warn {
  id          Int      @id @default(autoincrement())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId      String
  moderatorId String
  reason      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([guildId, userId])
  @@map("warns")
}

/// Settings of the custom automod layer (on top of Discord's native AutoMod).
model AutomodConfig {
  guildId String @id
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  /// Rules and sanctions, validated by `automodRulesSchema` (src/schemas/automod.ts): adding an
  /// option needs no migration.
  rules             Json     @default("{}")
  ignoredChannelIds String[] @default([])
  ignoredRoleIds    String[] @default([])
  /// Members with the "Manage Messages" permission are not checked.
  exemptStaff       Boolean  @default(true)

  updatedAt DateTime @updatedAt

  @@map("automod_configs")
}

/// Per-guild moderation settings.
model ModerationSettings {
  guildId        String   @id
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  dmOnSanction   Boolean  @default(true)
  /// Automatic sanction steps based on the active warn count, validated by
  /// `warnEscalationSchema` (src/schemas/moderation.ts).
  warnEscalation Json     @default("[]")
  updatedAt      DateTime @updatedAt

  @@map("moderation_settings")
}

enum LoopMode {
  NONE
  TRACK
  QUEUE
}

/// Persistent per-guild music settings.
model MusicSettings {
  guildId     String   @id
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  volume      Int      @default(100)
  stay247     Boolean  @default(false)
  defaultLoop LoopMode @default(NONE)
  /// Channels where `/blindtest` can be started; empty list = every channel.
  blindtestChannelIds         String[] @default([])
  /// Ids of the preset blindtest categories disabled on this guild.
  blindtestDisabledCategories String[] @default([])
  updatedAt   DateTime @updatedAt

  @@map("music_settings")
}

/// Track list a guild created for its blindtests. `tracks` is validated by
/// `blindtestTracksSchema` (src/schemas/blindtest.ts); `trackCount` avoids reading the JSON to list.
model BlindtestPlaylist {
  id         String   @id @default(cuid())
  guildId    String
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name       String
  tracks     Json     @default("[]")
  trackCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([guildId, name])
  @@map("blindtest_playlists")
}

/// Persistent cache of the Discord entitlements (fallback source of truth after a restart).
model PremiumEntitlement {
  id        String    @id
  skuId     String
  guildId   String?
  userId    String?
  deleted   Boolean   @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  updatedAt DateTime  @updatedAt

  @@index([guildId])
  @@map("premium_entitlements")
}

/// Heartbeat written periodically by each shard process (see apps/bot/src/core/heartbeat); the API
/// aggregates these rows for the global statistics shown on the dashboard.
model ShardStatus {
  shardId     Int      @id
  guildCount  Int
  memberCount Int      @default(0)
  ping        Int
  memoryMb    Int      @default(0)
  playerCount Int      @default(0)
  startedAt   DateTime
  updatedAt   DateTime @updatedAt

  @@map("shard_status")
}

/// Per-shard metric history in 10 minute buckets (UTC), for the admin panel charts. Each heartbeat
/// updates the current bucket; the API sums the shards.
model ShardMetricSample {
  shardId     Int
  bucket      DateTime
  guildCount  Int
  memberCount Int
  /// Sum of the pings sampled in the bucket and sample count, to derive the average.
  pingTotal   Int      @default(0)
  pingSamples Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([shardId, bucket])
  @@index([bucket])
  @@map("shard_metric_samples")
}

/// Counter aggregated per day (UTC) and per command, feeds the admin panel statistics tab.
model CommandUsageDaily {
  date        DateTime @db.Date
  commandName String
  /// The command's `modules/<module>` folder on the bot side, to filter statistics by category.
  category    String   @default("other")
  count       Int      @default(0)

  @@id([date, commandName])
  @@index([date])
  @@map("command_usage_daily")
}

/// Credit account of a Discord user. Credits are earned by voting for Gaulia on top.gg (vote
/// webhook, see apps/api/src/routes/topgg.routes.ts) and spent on granted premium for a guild
/// (Guild.premiumGrantedUntil). `username` and `avatar` are denormalized from the vote payload so
/// the admin panel shows something other than an id.
model CreditAccount {
  userId      String   @id
  username    String?
  avatar      String?
  balance     Int      @default(0)
  /// Lifetime credits earned (votes plus admin additions), never decremented: a historical
  /// reference in the admin panel.
  totalEarned Int      @default(0)
  voteCount   Int      @default(0)
  lastVoteAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions CreditTransaction[]

  @@index([balance])
  @@map("credit_accounts")
}

enum CreditTransactionType {
  /// top.gg vote
  VOTE
  /// Redeemed for granted premium
  PREMIUM_REDEEM
  /// Manual addition or removal from the admin panel
  ADMIN_ADJUST
  /// Pro rata refund of unused granted premium, when moving to the paid subscription
  PREMIUM_REFUND
}

/// Credit movement log: each row explains one balance change, which keeps admin adjustments
/// auditable and lets the user see a history.
model CreditTransaction {
  id           Int                   @id @default(autoincrement())
  userId       String
  account      CreditAccount         @relation(fields: [userId], references: [userId], onDelete: Cascade)
  type         CreditTransactionType
  /// Positive for a gain, negative for a spend.
  amount       Int
  balanceAfter Int
  /// Guild involved in a premium redeem, null otherwise.
  guildId      String?
  /// Author of an admin adjustment (OWNER_IDS), null otherwise.
  actorId      String?
  reason       String?
  createdAt    DateTime              @default(now())

  @@index([userId, createdAt])
  @@map("credit_transactions")
}

/// top.gg votes already processed, keyed by the vote id given in the webhook. top.gg retries a
/// delivery until it succeeds, so this table guarantees a vote credits the user only once.
model TopggVote {
  id        String   @id
  userId    String
  weight    Int      @default(1)
  votedAt   DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("topgg_votes")
}

// Adventure module.
// The character is global (one per Discord user, playable in DMs as well as on any allowed guild):
// only channel access is configured per guild, through AdventureSettings.

/// How to read `channelIds`: allowlist (only these channels) or blocklist (all but these).
enum AdventureChannelMode {
  ALLOWLIST
  BLOCKLIST
}

/// Adventure module access on a guild. Default: empty allowlist, so the adventure is unplayable in
/// the guild channels until one is allowed (DMs stay open regardless).
model AdventureSettings {
  guildId     String               @id
  guild       Guild                @relation(fields: [guildId], references: [id], onDelete: Cascade)
  enabled     Boolean              @default(true)
  channelMode AdventureChannelMode @default(ALLOWLIST)
  channelIds  String[]             @default([])
  updatedAt   DateTime             @updatedAt

  @@map("adventure_settings")
}

enum AdventureClass {
  GUERRIER
  MAGE
  RODEUR
}

/// A player's character. `hp` and `energy` are the values frozen at `regenAt`: the actual
/// regeneration is computed on read (see services/character/vitalsService.ts on the bot side),
/// which avoids any background job for thousands of players.
model AdventureCharacter {
  userId         String         @id
  /// Denormalized on every session so the admin panel shows something other than an id.
  username       String?
  characterClass AdventureClass

  level      Int @default(1)
  /// Experience accumulated in the current level (reset on each level up).
  xp         Int @default(0)
  /// Total experience earned since creation, never decremented: used by the leaderboards.
  totalXp    Int @default(0)
  statPoints Int @default(0)
  might      Int @default(0)
  agility    Int @default(0)
  spirit     Int @default(0)

  hp       Int
  energy   Int
  /// Last time hp and energy were recomputed.
  regenAt  DateTime @default(now())
  gold     Int      @default(0)
  /// Echo shards: story currency, earned from quests and dungeons, spent to seal a chapter. This
  /// is the resource that paces the story.
  echoes   Int      @default(0)

  zoneId          String @default("clairiere")
  actIndex        Int    @default(0)
  chapterIndex    Int    @default(0)
  /// Objective counters of the current chapter, validated by `chapterProgressSchema`.
  chapterProgress Json   @default("{}")
  storyEndedAt    DateTime?

  explorations  Int @default(0)
  victories     Int @default(0)
  defeats       Int @default(0)
  dungeonClears Int @default(0)
  upgrades      Int @default(0)
  trades        Int @default(0)
  streak        Int @default(0)
  bestStreak    Int @default(0)

  lastPlayedAt  DateTime?
  /// Day (UTC) of the last session counted in the daily streak.
  lastStreakDay DateTime?
  lastDungeonAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          AdventureItem[]
  quests         AdventureQuest[]
  achievements   AdventureAchievement[]
  logs           AdventureLog[]
  tradesSent     AdventureTrade[]       @relation("AdventureTradeInitiator")
  tradesReceived AdventureTrade[]       @relation("AdventureTradeTarget")

  @@index([level, totalXp])
  @@map("adventure_characters")
}

/// Inventory row. `itemId` references the code catalog (modules/adventure/data/items.ts): adding
/// an item needs no migration.
model AdventureItem {
  id           Int                @id @default(autoincrement())
  userId       String
  character    AdventureCharacter @relation(fields: [userId], references: [userId], onDelete: Cascade)
  itemId       String
  quantity     Int                @default(1)
  /// True for the piece worn in its slot (one per slot, enforced by the service).
  equipped     Boolean            @default(false)
  /// Upgrade tier of this player's copy (0 to 10, see data/adventureUpgrades.ts). It does not
  /// follow the item through a trade: it rewards whoever spent the resources.
  upgradeLevel Int                @default(0)
  updatedAt    DateTime           @updatedAt

  @@unique([userId, itemId])
  @@index([userId])
  @@map("adventure_items")
}

enum AdventureQuestKind {
  DAILY
  WEEKLY
}

/// A quest from a daily or weekly batch. `periodStart` identifies the batch (UTC day or UTC
/// Monday): a new batch is drawn on the first command of the period, older ones stay as history
/// until the retention job purges them.
model AdventureQuest {
  id          Int                @id @default(autoincrement())
  userId      String
  character   AdventureCharacter @relation(fields: [userId], references: [userId], onDelete: Cascade)
  kind        AdventureQuestKind
  questId     String
  target      Int
  progress    Int                @default(0)
  claimedAt   DateTime?
  periodStart DateTime

  @@unique([userId, kind, questId, periodStart])
  @@index([userId, kind, periodStart])
  @@map("adventure_quests")
}

/// Unlocked achievement (code catalog, see data/achievements.ts).
model AdventureAchievement {
  userId        String
  character     AdventureCharacter @relation(fields: [userId], references: [userId], onDelete: Cascade)
  achievementId String
  unlockedAt    DateTime           @default(now())

  @@id([userId, achievementId])
  @@map("adventure_achievements")
}

enum AdventureLogType {
  STORY
  DUNGEON
  LEVEL_UP
  TRADE
  ADMIN
}

/// Character log: milestones (chapters, dungeons, levels) and admin panel actions, which stay
/// auditable for the player as well as for the bot owner.
model AdventureLog {
  id        Int                @id @default(autoincrement())
  userId    String
  character AdventureCharacter @relation(fields: [userId], references: [userId], onDelete: Cascade)
  type      AdventureLogType
  message   String
  /// Owner behind an admin action, null for a game event.
  actorId   String?
  createdAt DateTime           @default(now())

  @@index([userId, createdAt])
  @@map("adventure_logs")
}

enum AdventureTradeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

/// Trade offer between two adventurers. Both sides are stored as JSON (validated by
/// `adventureTradeItemsSchema`), so adding an item to the catalog needs no migration. Nothing is
/// taken when the offer is made: everything is checked and moved on acceptance, which avoids
/// locking resources in an offer that may never go through.
model AdventureTrade {
  id          Int                  @id @default(autoincrement())
  initiatorId String
  initiator   AdventureCharacter   @relation("AdventureTradeInitiator", fields: [initiatorId], references: [userId], onDelete: Cascade)
  targetId    String
  target      AdventureCharacter   @relation("AdventureTradeTarget", fields: [targetId], references: [userId], onDelete: Cascade)
  status      AdventureTradeStatus @default(PENDING)

  /// What the initiator gives, and what they ask in return.
  offeredItems   Json @default("[]")
  offeredGold    Int  @default(0)
  requestedItems Json @default("[]")
  requestedGold  Int  @default(0)

  /// Channel the offer was made in, so the answer lands in the same place.
  channelId  String?
  expiresAt  DateTime
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([targetId, status])
  @@index([initiatorId, status])
  @@index([status, expiresAt])
  @@map("adventure_trades")
}
