{
  "name": "@gaulia/bot",
  "version": "5.0.0",
  "description": "Gaulia — bot Discord (modération, automod, musique, premium, sharding)",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/bot.ts",
    "start": "node dist/index.js",
    "start:single": "node dist/bot.js",
    "deploy": "tsx src/handlers/deploy-commands.ts",
    "deploy:guild": "tsx src/handlers/deploy-commands.ts --guild"
  },
  "dependencies": {
    "@discordjs/rest": "^2.4.3",
    "@gaulia/database": "*",
    "discord-api-types": "^0.38.55",
    "discord.js": "14.27.0",
    "dotenv": "^16.4.7",
    "lavalink-client": "2.11.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
